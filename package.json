{
  "name": "bookly",
  "version": "0.1.0",
  "private": true,
  "description": "Bookly — Big ideas. Five minutes. Uzbek-first nonfiction summaries with bilingual English practice.",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node --experimental-strip-types scripts/sync-content.mts",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "sync": "node --experimental-strip-types scripts/sync-content.mts",
    "seed": "node --experimental-strip-types scripts/sync-content.mts --force",
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "android:assets": "capacitor-assets generate --android --iconBackgroundColor '#FBFAF6' --iconBackgroundColorDark '#0C1714' --splashBackgroundColor '#FBFAF6' --splashBackgroundColorDark '#0C1714'",
    "android:bundle": "cd android && ./gradlew bundleRelease",
    "store:assets": "node scripts/store-assets.cjs"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/network": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capgo/capacitor-media-session": "^8.1.11",
    "@capgo/capacitor-social-login": "^8.7.13",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@revenuecat/purchases-capacitor": "^14.1.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3"
  }
}
