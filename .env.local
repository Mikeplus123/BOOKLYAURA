# ─── Supabase (required for Google sign-in, syncing, premium and admin) ───
# Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The publishable (or legacy "anon") key. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server-only. Used by the seed script and to cache AI explanations. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL (used for OAuth redirects and metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── AI (Claude) — enables "Tushuntir" sentence explanations and the admin content builder ───
ANTHROPIC_API_KEY=
# Optional overrides
# BOOKLY_AI_MODEL=claude-opus-5-5
# Daily explanation limits per user
# BOOKLY_AI_DAILY_FREE=15
# BOOKLY_AI_DAILY_PREMIUM=100
