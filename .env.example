# ─── Supabase (required for Google sign-in, syncing, premium and admin) ───
# Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The publishable (or legacy "anon") key. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server-only. Used by the seed script and to cache AI explanations. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL (used for OAuth redirects and metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── AI (Claude) — enables "Tushuntir" sentence explanations and the admin content builder ───
ANTHROPIC_API_KEY=
# Optional overrides
# BOOKLY_AI_MODEL=claude-opus-5-5
# Daily explanation limits per user
# BOOKLY_AI_DAILY_FREE=15
# BOOKLY_AI_DAILY_PREMIUM=100

# ─── Support & legal (shown in the Privacy Policy, Terms and Play listing) ───
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_TELEGRAM=https://t.me/

# ─── Android app (see docs/ANDROID_RELEASE.md) ───
# Google Cloud *Web* OAuth client ID (the one Supabase's Google provider uses). Needed for native sign-in.
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Play Console → App integrity → App signing → SHA-256 fingerprint(s), comma-separated (for App Links)
ANDROID_SHA256_CERT_FINGERPRINTS=
# "true" once the app is public on Google Play (shows "Get the app" links on the website)
NEXT_PUBLIC_ANDROID_LIVE=false

# ─── Google Play Billing via RevenueCat (Premium in the app) ───
NEXT_PUBLIC_REVENUECAT_ANDROID_KEY=
NEXT_PUBLIC_REVENUECAT_ENTITLEMENT=premium
# Server only:
REVENUECAT_SECRET_KEY=
REVENUECAT_WEBHOOK_AUTH=
